{
  "name": "pecho",
  "productName": "Personal Echo",
  "version": "1.0.0",
  "description": "Personal meeting summarizer using Ollama",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "npm run package",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "pretypecheck": "npm run build:renderer",
    "check": "npm run format && npm run typecheck && npm run lint && npm run test:unit",
    "test:e2e:packaged": "playwright test",
    "bench:compiler": "node scripts/benchmark-react-compiler.mjs"
  },
  "author": "Alex Spinu <spinualexandru@outlook.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.4.3",
    "electron-devtools-installer": "^4.0.0",
    "jsdom": "^30.1.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "ollama": "^0.6.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "systeminformation": "^5.33.13",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
    "tmp": "^0.2.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "onnxruntime-node": false,
    "protobufjs@7.6.6": true
  }
}
